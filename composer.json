{
    "name": "itamelions/mono-php-sdk",
    "description": "PHP SDK for the Mono open banking API (mandates, accounts, debits, webhooks)",
    "type": "library",
    "license": "MIT",
    "keywords": ["mono", "open-banking", "api", "sdk", "payments", "mandates", "nigeria"],
    "authors": [
        { "name": "Daniel Ishola", "email": "hello@danielishola.com" }
    ],
    "require": {
        "php": "^8.1",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "Mono\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Mono\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "config": {
        "sort-packages": true
    }
}
